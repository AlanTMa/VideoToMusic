
# .env.example

# Application Settings
DEBUG=true
APP_NAME=SilentVideoSynth
VERSION=1.0.0

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Handling
MAX_FILE_SIZE=104857600  # 100MB
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
STATIC_DIR=static

# Model Configuration
MODEL_DIR=models
MODEL_NAME=silentvideosynth-v1
DEVICE=auto  # auto, cpu, cuda
MODEL_CACHE_SIZE=2

# Generation Settings
DEFAULT_TIMEOUT=300
MAX_QUEUE_SIZE=100
CLEANUP_INTERVAL=3600
SESSION_EXPIRY=86400

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/silentvideosynth
REDIS_URL=redis://localhost:6379

# Security
API_KEY=your-secret-api-key
RATE_LIMIT=100/hour

# Audio Processing
SAMPLE_RATE=44100
AUDIO_FORMAT=wav
MIDI_RESOLUTION=480

# Video Processing
VIDEO_FPS=1
MAX_VIDEO_DURATION=300

# Feature Extraction
CLIP_MODEL=openai/clip-vit-base-patch32
EMOTION_CATEGORIES=exciting,fearful,tense,sad,relaxing,neutral

# Training
TRAINING_DATA_DIR=training_data
CHECKPOINT_DIR=checkpoints
TENSORBOARD_DIR=tensorboard

# Monitoring
SENTRY_DSN=
LOG_LEVEL=INFO